{
  "name": "cubed-desktop",
  "version": "1.0.2",
  "description": "CUBED desktop app",
  "author": "CUBED",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "cubed": {
    "url": "https://cubed-9du.caffeine.xyz",
    "releases": "Leojls9744/cubed-desktop"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.cubed.desktop",
    "productName": "CUBED",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "CUBED Document",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "CUBED Document",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "CUBED Document",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "CUBED Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "CUBED Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "tsv",
        "name": "CUBED Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "xls",
        "name": "CUBED Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "ods",
        "name": "CUBED Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "CUBED Presentation",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "tif",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "tiff",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "png",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "jpg",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "jpeg",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "webp",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "gif",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      },
      {
        "ext": "bmp",
        "name": "CUBED PDF or Image",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "CUBED"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "text/csv",
        "application/pdf",
        "image/tiff",
        "image/png",
        "image/jpeg"
      ]
    },
    "artifactName": "CUBED-${os}-${arch}.${ext}",
    "afterPack": "build/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Leojls9744",
        "repo": "cubed-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
